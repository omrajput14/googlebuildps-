# --- Server only (never exposed to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Browser (baked in at build time) ---
# Google Maps JS API key (restrict by HTTP referrer). Empty = built-in SVG map fallback.
VITE_GOOGLE_MAPS_API_KEY=YOUR_MAPS_KEY_HERE

# Firebase web config. Leave VITE_FIREBASE_API_KEY empty to run on local mock data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=

# Password shared by the 4 seeded demo accounts (<role>@swasthchain.demo). Demo only.
VITE_DEMO_PASSWORD=

# --- Seed script (npm run seed) ---
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
DEMO_PASSWORD=
